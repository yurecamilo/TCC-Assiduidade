<Window x:Class="TCC_Assiduidade.View.Popups.ImportarPresenca"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCC_Assiduidade.View"
        xmlns:conv="clr-namespace:TCC_Assiduidade.View.Converters"
        mc:Ignorable="d"
        Title="Processo de Importação" 
        Height="400" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="BarraProgressoPopUp" TargetType="ProgressBar">
            <Setter Property="Background" Value="#D8E5E5"/>
            <Setter Property="Foreground" Value="#2A5C60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#E0EBEB"/>
            <Setter Property="BorderBrush" Value="#BFCFCF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0,30,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="GridBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" />
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <ToggleButton Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" HorizontalAlignment="Right" Width="30" Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M7,10L12,15L17,10H7Z" Fill="#2A5C60" HorizontalAlignment="Center" VerticalAlignment="Center" Width="14" Height="14" Stretch="Uniform" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <Border Background="White" BorderBrush="#BFCFCF" BorderThickness="1" CornerRadius="0,0,5,5" Margin="0,1,0,0">
                                        <ScrollViewer>
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PopUpActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A5C60"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4A6984"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopUpCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource PopUpActionButtonStyle}">
            <Setter Property="Background" Value="#757575"/>
        </Style>
    </Window.Resources>

    <Border Background="#E5EFEF" CornerRadius="12" BorderBrush="#B6C9C9" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5">
                <TextBlock Text="Importação de Presença de Alunos" 
                           FontSize="20" FontWeight="Bold" Foreground="#11181C" 
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>

                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" 
                        Foreground="#889898" FontSize="18" FontWeight="Bold" Cursor="Hand" 
                        Click="BtnCancelar_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                <StackPanel>

                    <TextBlock Text="Passo 1: Seleção da turma" FontSize="15" FontWeight="Bold" Foreground="#222" Margin="0,0,0,8"/>
                    <Border BorderBrush="#BFCFCF" BorderThickness="1" CornerRadius="8" Padding="15" Background="#F0F7F7" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid>
                                <ComboBox x:Name="CbTurmas" 
                                           Height="38" 
                                           Style="{StaticResource ComboBoxStyle}"
                                           FontSize="14" 
                                           VerticalContentAlignment="Center"
                                           ItemsSource="{Binding Turmas}"
                                           SelectedItem="{Binding TurmaSelecionada, Mode=TwoWay}"
                                           DisplayMemberPath="Nome">
                                </ComboBox>

                                <TextBlock Text="Selecionar a turma de destino" 
                                    Foreground="#99AAB5" 
                                    FontSize="14" 
                                    VerticalAlignment="Center" 
                                    Margin="10,0,30,0"
                                    IsHitTestVisible="False">            
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=CbTurmas, Converter={StaticResource NullToVisibility}}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Passo 2: Origem dos dados de presença (CSV ou Google Forms)" FontSize="15" FontWeight="Bold" Foreground="#222" Margin="0,0,0,8"/>
                    <Border BorderBrush="#BFCFCF" BorderThickness="1" CornerRadius="8" Padding="15" Background="#F0F7F7">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource SecondaryActionButtonStyle}" Width="140" Height="38" Command="{Binding SelecionarArquivoCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M12,11L16,15H13V18H11V15H8L12,11Z" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Escolher CSV" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Style="{StaticResource PopUpActionButtonStyle}" Width="160" Height="38" Margin="8,0,0,0"
                                        Command="{Binding SincronizarFormsCommand}" Background="#2A5C60">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12,18.5A6.5,6.5 0 0,1 5.5,12A6.5,6.5 0 0,1 12,5.5A6.47,6.47 0 0,1 16.95,7.55L14,10.5H21V3.5L18.6,5.9A8.5,8.5 0 1,0 12,20.5C15.63,20.5 18.69,18.22 19.86,15H17.65A6.5,6.5 0 0,1 12,18.5Z" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sincronizar Forms" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <TextBox Grid.Column="2" BorderBrush="Transparent" Height="38" Margin="10,0,0,0" IsReadOnly="True" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Foreground="#556666"
                                    Text="{Binding CaminhoArquivo, Mode=OneWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2">
                <Button Content="Iniciar Importação" Style="{StaticResource PopUpActionButtonStyle}" HorizontalAlignment="Stretch" Height="40" FontSize="15"
                Command="{Binding IniciarImportacaoCommand}"/>
            </StackPanel>

            <!-- Overlay de progresso da importação: cobre toda a janela e bloqueia interações até o fim da operação. -->
            <Grid Grid.RowSpan="3" Background="#D9E9EFEF" Visibility="{Binding EstaOcupado, Converter={StaticResource BoolToVis}}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#B6C9C9" BorderThickness="1" CornerRadius="10" Padding="28,22" Width="320">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.18"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Importando presença" FontSize="15" FontWeight="Bold" Foreground="#11181C" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Style="{StaticResource BarraProgressoPopUp}" Value="{Binding ProgressoImportacao, Mode=OneWay}"/>
                        <TextBlock Text="{Binding EtapaImportacao}" FontSize="12" Foreground="#55686A" HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>