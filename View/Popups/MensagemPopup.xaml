<Window x:Class="TCC_Assiduidade.View.Popups.MensagemPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mensagem"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="PopUpActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A5C60"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopUpCancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#757575"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#E5EFEF" CornerRadius="12" BorderBrush="#B6C9C9" BorderThickness="1" Margin="10" Padding="24,18,24,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="TxtTitulo"
                           Text=""
                           FontSize="17" FontWeight="Bold" Foreground="#11181C"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           TextWrapping="Wrap" MaxWidth="330"/>
                <Button x:Name="BtnFechar" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#889898" FontSize="18" FontWeight="Bold" Cursor="Hand" IsDefault="False"
                        Click="BtnFechar_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Path x:Name="Icone"
                      Grid.Column="0"
                      Data=""
                      Fill="#2A5C60"
                      Width="40" Height="40" Stretch="Uniform"
                      Margin="0,0,14,0" VerticalAlignment="Center"/>

                <TextBlock x:Name="TxtMensagem"
                           Grid.Column="1"
                           Text=""
                           FontSize="14" Foreground="#11181C"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </Grid>

            <StackPanel x:Name="PainelBotoes" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnOk" Content="OK" Width="90" Style="{StaticResource PopUpActionButtonStyle}" IsDefault="True" Click="BtnOk_Click"/>
                <Button x:Name="BtnSim" Content="Sim" Width="90" Style="{StaticResource PopUpActionButtonStyle}" IsDefault="True" Click="BtnSim_Click" Margin="8,0,0,0"/>
                <Button x:Name="BtnNao" Content="Não" Width="90" Style="{StaticResource PopUpCancelButtonStyle}" Click="BtnNao_Click" Margin="8,0,0,0"/>
                <Button x:Name="BtnCancelar" Content="Cancelar" Width="90" Style="{StaticResource PopUpCancelButtonStyle}" IsCancel="True" Click="BtnCancelar_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
