<UserControl x:Class="TCC_Assiduidade.View.Dashboards.DashboardAlunosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:TCC_Assiduidade.View.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="960">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DashboardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource DashboardScrollViewerStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Background="Transparent" HorizontalAlignment="Left" Margin="0,0,0,5"
                    Style="{StaticResource DashboardBackButtonStyle}"
                    Command="{Binding VoltarCommand}">
                <TextBlock Text="← Voltar para o Dashboard" FontWeight="Regular"/>
            </Button>

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dashboard de Alunos" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Assiduidade individual e comparação com a turma."
                               Foreground="#A0AAB0" FontSize="16"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Gerar HTML"
                        Style="{StaticResource DashboardPrimaryButtonStyle}"
                        Command="{Binding GerarHtmlCommand}"
                        VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource DashboardFilterPanelStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Filtragem e Busca" Foreground="#11181C" FontSize="18"
                               FontWeight="Bold" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <StackPanel Width="210" Margin="0,0,12,0">
                            <TextBlock Text="Turma" Style="{StaticResource DashboardInputLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Turmas}"
                                      SelectedItem="{Binding TurmaSelecionada, Mode=TwoWay}"
                                      DisplayMemberPath="Nome"
                                      Style="{StaticResource DashboardComboStyle}"/>
                        </StackPanel>
                        <StackPanel Width="250" Margin="0,0,12,0">
                            <TextBlock Text="Aluno" Style="{StaticResource DashboardInputLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Alunos}"
                                      SelectedItem="{Binding AlunoSelecionado, Mode=TwoWay}"
                                      DisplayMemberPath="Descricao"
                                      Style="{StaticResource DashboardComboStyle}"/>
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,12,0">
                            <TextBlock Text="Data inicial" Style="{StaticResource DashboardInputLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding DataInicio, Mode=TwoWay}"
                                        Style="{StaticResource DashboardDateStyle}"/>
                        </StackPanel>
                        <StackPanel Width="160">
                            <TextBlock Text="Data final" Style="{StaticResource DashboardInputLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding DataFim, Mode=TwoWay}"
                                        Style="{StaticResource DashboardDateStyle}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="3" Text="{Binding MensagemEstado}" Foreground="#F0C674"
                       FontSize="13" Margin="3,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Grid.Row="4" Style="{StaticResource DashboardPanelStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding NomeAluno}" Foreground="#11181C" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DetalheAluno}" Foreground="#64767B" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F5DDBC" CornerRadius="7" Padding="10,6">
                        <TextBlock Text="{Binding SituacaoTexto}" Foreground="#8A4D16" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="5" Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource DashboardMetricStyle}">
                    <StackPanel>
                        <TextBlock Text="Assiduidade" Style="{StaticResource DashboardMetricLabelStyle}"/>
                        <TextBlock Text="{Binding AssiduidadeTexto}" Style="{StaticResource DashboardMetricValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardMetricStyle}">
                    <StackPanel>
                        <TextBlock Text="Aulas presentes" Style="{StaticResource DashboardMetricLabelStyle}"/>
                        <TextBlock Text="{Binding PresencasTexto}" Style="{StaticResource DashboardMetricValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardMetricStyle}">
                    <StackPanel>
                        <TextBlock Text="Média da turma" Style="{StaticResource DashboardMetricLabelStyle}"/>
                        <TextBlock Text="{Binding MediaTurmaTexto}" Style="{StaticResource DashboardMetricValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardMetricStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Posição na turma" Style="{StaticResource DashboardMetricLabelStyle}"/>
                        <TextBlock Text="{Binding PosicaoTexto}" Style="{StaticResource DashboardMetricValueStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="2" Style="{StaticResource DashboardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Evolução de assiduidade"
                                       Style="{StaticResource DashboardChartTitleStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Rectangle Width="9" Height="9" Fill="#3E78B2" Margin="0,0,5,0"/>
                                <TextBlock Text="Aluno" Foreground="#526469" FontSize="11" Margin="0,0,12,0"/>
                                <Rectangle Width="9" Height="9" Fill="#2F8F73" Margin="0,0,5,0"/>
                                <TextBlock Text="Turma" Foreground="#526469" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Percentual de presença por mês"
                                   Style="{StaticResource DashboardChartCaptionStyle}"/>
                        <controls:DashboardLineChart Grid.Row="2" Height="230"
                                                     Pontos="{Binding Evolucao}"
                                                     MostrarSerieSecundaria="True"/>
                    </Grid>
                </Border>

                <Border Grid.Column="0" Style="{StaticResource DashboardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Frequência no período"
                                   Style="{StaticResource DashboardChartTitleStyle}"/>
                        <TextBlock Grid.Row="1" Text="Presenças e ausências no período"
                                   Style="{StaticResource DashboardChartCaptionStyle}"/>
                        <controls:DashboardDonutChart Grid.Row="2" Height="230"
                                                      Resultado="{Binding Resultado}"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Width="10" Height="10" Fill="#2F8F73" Margin="0,0,6,0"/>
                            <TextBlock Text="Presenças" Foreground="#526469" FontSize="12" Margin="0,0,18,0"/>
                            <Rectangle Width="10" Height="10" Fill="#D7E7E4" Margin="0,0,6,0"/>
                            <TextBlock Text="Ausências" Foreground="#526469" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
