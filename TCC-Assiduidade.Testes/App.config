<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Valor fictício: os testes deste projeto cobrem apenas validações e lógica
         pura que nunca chegam a abrir uma conexão real com o banco. A string
         só precisa existir para o construtor dos repositórios não lançar
         NullReferenceException ao ler ConfigurationManager.ConnectionStrings. -->
    <add name="MyDbConn" connectionString="server=localhost;port=3306;database=testes;user=teste;password=teste;" providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
